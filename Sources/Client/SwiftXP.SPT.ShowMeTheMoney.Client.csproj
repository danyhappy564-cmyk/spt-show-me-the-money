<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>2.8.0</Version>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <AssemblyName>SwiftXP.SPT.ShowMeTheMoney.Client</AssemblyName>
    <Product>Show Me The Money</Product>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>SwiftXP.SPT.ShowMeTheMoney.Client</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <LicenseToolPath>$(HOME)/.dotnet/tools/dotnet-project-licenses</LicenseToolPath>
    <LicenseToolPath Condition="'$(OS)' == 'Windows_NT'">
      $(UserProfile)\.dotnet\tools\dotnet-project-licenses.exe</LicenseToolPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Sources/Common/ConfigurationManager/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Sources/Common/Constants/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Sources/Common/Environment/EFTGameExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Sources/Common/Loggers/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Sources/Common/Notifications/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Sources/Common/Runtime/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Sources/Common/Sessions/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(SptBepInEx)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(SptManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(SptBepInEx)\core\BepInEx.dll" Private="false" />
    <Reference Include="$(SptManaged)\Comfort.dll" Private="false" />
    <Reference Include="$(SptManaged)\ItemComponent.Types.dll" Private="false" />
    <Reference Include="$(SptManaged)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(SptManaged)\Sirenix.Serialization.dll" Private="false" />
    <Reference Include="$(SptBepInEx)\plugins\spt\spt-common.dll" Private="false" />
    <Reference Include="$(SptBepInEx)\plugins\spt\spt-reflection.dll" Private="false" />
    <Reference Include="$(SptManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(SptManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(SptManaged)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(SptManaged)\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

  <!-- Drop the built plugin straight into the install, so no file has to be copied by hand. -->
  <Target Name="CopyToSPT" AfterTargets="AfterBuild" Condition="Exists('$(SptRoot)')">
    <MakeDir Directories="$(SptRoot)\BepInEx\plugins\com.swiftxp.spt.showmethemoney" />
    <Copy SourceFiles="$(TargetPath)"
      DestinationFolder="$(SptRoot)\BepInEx\plugins\com.swiftxp.spt.showmethemoney" />
  </Target>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2"
      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="GenerateLicenseFile" AfterTargets="Publish">
    <Message Text="Generating license file..." Importance="high" />

    <Exec
      Command="$(LicenseToolPath) --input &quot;$(MSBuildProjectFullPath)&quot; --output --outfile &quot;$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Client.LICENSES.txt&quot;"
      EnvironmentVariables="DOTNET_ROLL_FORWARD=Major"
      ConsoleToMSBuild="true"
      IgnoreExitCode="false" />

    <Message Text="License file generated." Importance="high" />
  </Target>

  <Target Name="CopyToPublishFolder" AfterTargets="GenerateLicenseFile">
    <Message Text="Copying published files to /Publish folder..." Importance="high" />

    <ItemGroup>
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Client.dll" />
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Client.LICENSES.txt" />
    </ItemGroup>

    <Copy SourceFiles="@(PublishedFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)/../../Publish/BepInEx/plugins/com.swiftxp.spt.showmethemoney" />
  </Target>

  <!--
    Rule 2-2: every Release build also drops a ready-to-ship archive in release/.
    Skip with -p:SkipPackage=true.
  -->
  <Target Name="PackageRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipPackage)' != 'true'">
    <PropertyGroup>
      <PackageStageDir>$(IntermediateOutputPath)package\</PackageStageDir>
      <PackageZipDir>$(MSBuildThisFileDirectory)release\</PackageZipDir>
      <PackageZipPath>$(PackageZipDir)$(AssemblyName)-$(Version).zip</PackageZipPath>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="@(PackageFiles)"
          DestinationFiles="@(PackageFiles->'$(PackageStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(PackageZipDir)" />
    <Delete Files="$(PackageZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <Message Text="Packaged $(PackageZipPath)" Importance="high" />
  </Target>

</Project>
