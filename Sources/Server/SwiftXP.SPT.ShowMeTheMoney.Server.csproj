<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>2.8.0</Version>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <AssemblyName>SwiftXP.SPT.ShowMeTheMoney.Server</AssemblyName>
    <Product>Show Me The Money</Product>
    <RootNamespace>SwiftXP.SPT.ShowMeTheMoney.Server</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <LicenseToolPath>$(HOME)/.dotnet/tools/dotnet-project-licenses</LicenseToolPath>
    <LicenseToolPath Condition="'$(OS)' == 'Windows_NT'">
      $(UserProfile)\.dotnet\tools\dotnet-project-licenses.exe</LicenseToolPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Sources/Common/Runtime/AppMetadata.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(SptRuntime)\SPTarkov.Common.dll" Private="false" />
    <Reference Include="$(SptRuntime)\SPTarkov.DI.dll" Private="false" />
    <Reference Include="$(SptRuntime)\SPTarkov.Server.Core.dll" Private="false" />
    <Reference Include="$(SptRuntime)\SemanticVersioning.dll" Private="false" />
  </ItemGroup>

  <!--
    Drop the built server mod straight into the install, the way the client project already does.
    Without this, `dotnet build` produces a client plugin that immediately starts calling
    /showMeTheMoney/getFleaPrices and /showMeTheMoney/getPartialRagfairConfig against a server that
    has no handler for them - the server log fills with "unhandled response" on both routes and the
    mod is simply absent from the loaded-mod list, because nothing ever copied it there. The folder
    name matches the one the release layout uses (CopyToPublishFolder below).
  -->
  <Target Name="CopyToSPT" AfterTargets="AfterBuild" Condition="Exists('$(SptRuntime)')">
    <MakeDir Directories="$(SptRuntime)\user\mods\com.swiftxp.spt.showmethemoney" />
    <Copy SourceFiles="$(TargetPath)"
      DestinationFolder="$(SptRuntime)\user\mods\com.swiftxp.spt.showmethemoney" />
  </Target>

  <Target Name="GenerateLicenseFile" AfterTargets="Publish">
    <Message Text="Generating license file..." Importance="high" />

    <Exec
      Command="$(LicenseToolPath) --input &quot;$(MSBuildProjectFullPath)&quot; --output --outfile &quot;$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Server.LICENSES.txt&quot;"
      EnvironmentVariables="DOTNET_ROLL_FORWARD=Major"
      ConsoleToMSBuild="true"
      IgnoreExitCode="false" />

    <Message Text="License file generated." Importance="high" />
  </Target>

  <Target Name="CopyToPublishFolder" AfterTargets="GenerateLicenseFile">
    <Message Text="Copying published files to /Publish folder..." Importance="high" />

    <ItemGroup>
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Server.dll" />
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Server.LICENSES.txt" />
    </ItemGroup>

    <Copy SourceFiles="@(PublishedFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)/../../Publish/SPT/user/mods/com.swiftxp.spt.showmethemoney" />
  </Target>
</Project>
